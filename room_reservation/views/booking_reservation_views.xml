<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="booking_reservation_view_list" model="ir.ui.view">
        <field name="name">booking.reservation.list</field>
        <field name="model">booking.reservation</field>
        <field name="arch" type="xml">
            <list string="Reservations"
                  decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'confirmed'"
                  decoration-warning="state == 'to_approve'">
                <field name="name"/>
                <field name="room_id"/>
                <field name="start"/>
                <field name="stop"/>
                <field name="duration" widget="float_time" sum="Total"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="attendee_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="booking_reservation_view_form" model="ir.ui.view">
        <field name="name">booking.reservation.form</field>
        <field name="model">booking.reservation</field>
        <field name="arch" type="xml">
            <form string="Reservation">
                <header>
                    <button name="action_submit" string="Submit" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object"
                            class="btn-primary" invisible="state != 'to_approve'"
                            groups="room_reservation.group_booking_manager"/>
                    <button name="action_done" string="Mark as Done" type="object"
                            invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                            invisible="state not in ('to_approve', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,to_approve,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="room_id"
                                   readonly="state in ('done', 'cancelled')"/>
                            <field name="user_id" widget="many2one_avatar_user"
                                   readonly="state in ('done', 'cancelled')"/>
                            <field name="purpose"
                                   readonly="state in ('done', 'cancelled')"/>
                            <field name="attendee_count"
                                   readonly="state in ('done', 'cancelled')"/>
                        </group>
                        <group>
                            <field name="start"
                                   readonly="state in ('done', 'cancelled')"/>
                            <field name="stop"
                                   readonly="state in ('done', 'cancelled')"/>
                            <field name="duration" widget="float_time"/>
                        </group>
                    </group>
                    <group string="Requirements">
                        <field name="required_equipment_ids" widget="many2many_tags"
                               options="{'no_create_edit': True}"
                               readonly="state in ('done', 'cancelled')"/>
                    </group>
                    <!-- Only meaningful once someone approved, so it stays hidden
                         for drafts and pending requests. -->
                    <group string="Approval" invisible="not approver_id">
                        <field name="approver_id"/>
                        <field name="approval_date"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="booking_reservation_view_search" model="ir.ui.view">
        <field name="name">booking.reservation.search</field>
        <field name="model">booking.reservation</field>
        <field name="arch" type="xml">
            <search string="Reservations">
                <field name="name"/>
                <field name="room_id"/>
                <field name="user_id"/>
                <field name="purpose"/>
                <filter name="filter_my" string="My Reservations"
                        domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="filter_to_approve" string="To Approve"
                        domain="[('state', '=', 'to_approve')]"/>
                <filter name="filter_confirmed" string="Confirmed"
                        domain="[('state', '=', 'confirmed')]"/>
                <separator/>
                <filter name="filter_upcoming" string="Upcoming"
                        domain="[('start', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="filter_start" string="Start Date" date="start"/>
                <group>
                    <filter name="group_by_room" string="Room"
                            context="{'group_by': 'room_id'}"/>
                    <filter name="group_by_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_by_user" string="Organizer"
                            context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="booking_reservation_view_calendar" model="ir.ui.view">
        <field name="name">booking.reservation.calendar</field>
        <field name="model">booking.reservation</field>
        <field name="arch" type="xml">
            <calendar string="Reservations" date_start="start" date_stop="stop"
                      color="room_id" mode="week">
                <field name="name"/>
                <field name="room_id" filters="1"/>
                <field name="user_id"/>
            </calendar>
        </field>
    </record>

    <record id="booking_reservation_action" model="ir.actions.act_window">
        <field name="name">Reservations</field>
        <field name="res_model">booking.reservation</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="context">{'search_default_filter_upcoming': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Book a room</p>
            <p>Reservations are checked against room capacity, equipment and existing bookings.</p>
        </field>
    </record>

</odoo>
