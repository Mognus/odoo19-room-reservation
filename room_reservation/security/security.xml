<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_room_reservation" model="res.groups.privilege">
        <field name="name">Room Reservation</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_booking_user" model="res.groups">
        <field name="name">User: book rooms</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_room_reservation"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can see the full room occupancy and manage their own reservations.</field>
    </record>

    <record id="group_booking_manager" model="res.groups">
        <field name="name">Manager: approve reservations</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_room_reservation"/>
        <field name="implied_ids" eval="[(4, ref('group_booking_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Can approve requests and maintain rooms and equipment.</field>
    </record>

    <!--
        Reading is deliberately unrestricted: a user who cannot see why a room
        is occupied cannot plan around it, which would make the calendar useless.
    -->
    <record id="reservation_rule_read_all" model="ir.rule">
        <field name="name">Reservation: read every booking</field>
        <field name="model_id" ref="model_booking_reservation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('group_booking_user'))]"/>
    </record>

    <!-- Writing, however, stays with the organizer of the reservation. -->
    <record id="reservation_rule_own_write" model="ir.rule">
        <field name="name">Reservation: modify own bookings only</field>
        <field name="model_id" ref="model_booking_reservation"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="groups" eval="[(4, ref('group_booking_user'))]"/>
    </record>

    <record id="reservation_rule_manager_all" model="ir.rule">
        <field name="name">Reservation: managers handle every booking</field>
        <field name="model_id" ref="model_booking_reservation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_booking_manager'))]"/>
    </record>

</odoo>
